# Copy to .env and fill in. Paths are relative to the project folder.

# --- Which LLM answers: ollama (free) | claude (paid API, best quality) ---
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
# Models ending in -cloud run on Ollama's servers (needs `ollama signin`); others run on this machine
OLLAMA_MODEL=gemma4:31b-cloud
# Let the model reason before answering: true is ~0.5 s slower but far more reliable with tools
# (with false, Gemma sometimes writes tool calls or stray text instead of acting).
# gpt-oss: low | medium | high. Other thinking models: true | false. Empty = model default
OLLAMA_THINK=true

# --- Claude ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high - lower answers faster, which matters for a voice assistant
LLM_EFFORT=low
LLM_MAX_TOKENS=16000

# --- Conversation ---
ASSISTANT_NAME=Anna
# Language at startup: el or en = only listen and speak that language (the ΕΛ/EN switch on the
# screen, or asking the assistant, changes it); auto = work it out sentence by sentence
LANGUAGE=auto
# Forget the conversation after this many seconds without talking
CONVERSATION_TIMEOUT_S=300

# --- Speech-to-text ---
# groq (default: Whisper large-v3 on Groq's servers, best Greek; free key at console.groq.com)
# or a local engine: canary (told the language, so Greek stays Greek) | parakeet (faster, but may turn
# Greek into English - only for LANGUAGE=en) | whisper (slow)
STT_ENGINE=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
# Local engine used when Groq is unreachable, over its free limit, or has no key: canary | parakeet | whisper | none
STT_FALLBACK=canary
# Downloaded here on first run (~1 GB and ~670 MB)
CANARY_MODEL_DIR=models/canary-1b-v2
PARAKEET_MODEL_DIR=models/parakeet-tdt-0.6b-v3
# Whisper settings: WHISPER_LANGUAGE_MODEL decides Greek vs English for every engine;
# the rest only matter with STT_ENGINE=whisper
# tiny | base | small | medium | large-v3 ... bigger = more accurate but slower; small is a good start for Greek
WHISPER_MODEL=small
# Model used only to tell Greek from English when LANGUAGE=auto (tiny is fast and reliable for this)
WHISPER_LANGUAGE_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_DOWNLOAD_DIR=models/whisper
# Names the speech recognizer should expect (Groq and Whisper)
STT_HOTWORDS=Ridebly, Flarmio, VisionArrays, Quickord, Roomismo, Rate Manager, Desmos

# --- Text-to-speech (Piper) ---
PIPER_VOICE_EN=models/piper/en_US-lessac-medium.onnx
PIPER_VOICE_EL=models/piper/el_GR-rapunzelina-medium.onnx
# < 1 speaks faster, > 1 slower
TTS_LENGTH_SCALE=1.0

# --- Face window ---
FACE_PORT=8765
# true = fullscreen kiosk window (Alt+F4 closes it), false = normal window
FACE_FULLSCREEN=true
# Show what was heard and said as subtitles under the face
FACE_CAPTIONS=true
BROWSER_PROFILE_DIR=data/browser-profile
# Go back to the face when nobody has talked for this long while a web page is shown
BROWSE_IDLE_RETURN_S=90

# --- Camera (eyes follow the closest face) ---
CAMERA_ENABLED=true
CAMERA_INDEX=0
# Set to true if the eyes move away from you instead of toward you
CAMERA_MIRROR=false
CAMERA_FPS=15
# How far the eyes move for a given head position (higher = more)
GAZE_GAIN=1.3
FACE_DETECTION_MODEL=models/mediapipe/blaze_face_short_range.tflite

# --- Audio devices: empty = system default, a number = index, or part of the name ---
# Run `uv run assistant --list-devices` to see them.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# --- Voice activity detection (Silero) ---
# 0..1, raise if background noise triggers listening
VAD_THRESHOLD=0.5
# Silence that ends an utterance; shorter cuts sentences at natural pauses between phrases
VAD_MIN_SILENCE_MS=1000
# Shorter sounds are ignored
VAD_MIN_SPEECH_MS=250
VAD_MAX_UTTERANCE_S=30

# --- Ridebly live demo ---
RIDEBLY_APP_URL=https://dev.app.ridebly.com/
# Log in once with `assistant --login`; the browser profile remembers it.
# true = a test server, where the assistant may create example bookings and data during demos
RIDEBLY_APP_TEST_SERVER=true
# A live app demo needs approval, given by logging in on screen: how long Anna waits for it
RIDEBLY_APPROVAL_WAIT_S=300
